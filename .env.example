# Reference "today" for all business logic (brief: treat today as 15 May 2026)
TODAY=2026-05-15

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGIN=*

# Server (use 3001 locally so it does not clash with the Nuxt dev server on 3000;
# hosting platforms like Railway/Render inject their own PORT)
PORT=3001
